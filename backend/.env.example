# backend/.env.example  ->  kopjoje si .env dhe plotësoje (.env NUK shkon në Git)
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://shendet:shendet@localhost:5432/shendetplus
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
AGENT_MODEL=
GUARD_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Ofrues alternativ OpenAI-compatible (Groq, Gemini, etj.).
# Për gemini/groq mjaftojnë LLM_PROVIDER dhe LLM_API_KEY; URL-ja dhe modelet
# kanë vlera parazgjedhur. Fushat e tjera janë vetëm për mbivendosje.
# Për OpenAI lëre LLM_PROVIDER=openai. Çelësat realë VETËM në .env.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_AGENT_MODEL=
LLM_GUARD_MODEL=
# Shembull Gemini:
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_AGENT_MODEL=gemini-flash-latest
# LLM_GUARD_MODEL=gemini-flash-lite-latest
# Shembull Groq:
# LLM_PROVIDER=groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_AGENT_MODEL=llama-3.3-70b-versatile
# LLM_GUARD_MODEL=llama-3.1-8b-instant

JWT_SECRET=
FIELD_ENCRYPTION_KEYS=
DEFAULT_COUNTRY=XK
RATE_LIMIT_PER_MIN=20
SAFE_MODE=false

# Verifikimi me email (kodi 6-shifror). Kredencialet reale VETËM në .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
EMAIL_CODE_PEPPER=
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_PER_HOUR=10
